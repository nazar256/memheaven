FROM node:22-slim

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund

COPY src ./src
COPY glama ./glama
COPY migrations ./migrations
COPY tsconfig.json ./tsconfig.json

# stdio MCP protocol frames are written by the SDK directly to stdout.
# Keep diagnostics on stderr and do not expose an HTTP port.
CMD ["./node_modules/.bin/tsx", "glama/server.ts"]
